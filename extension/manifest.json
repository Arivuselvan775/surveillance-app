{
  "manifest_version": 3,
  "name": "Background Recorder",
  "version": "1.0",
  "description": "Records audio in the background.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Start Recording Engine"
  }
}
