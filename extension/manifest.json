{
  "manifest_version": 3,
  "name": "Background Recorder",
  "version": "1.0",
  "description": "Records audio in the background.",
  "permissions": [
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open Options to Grant Microphone Access"
  }
}
